# ---------------------------------------------------------------------------
# Configurazione Supabase
# ---------------------------------------------------------------------------
# 1. Copia questo file e rinomina la copia in ".env" (senza .example)
# 2. Sostituisci i due valori qui sotto con quelli del TUO progetto Supabase
#    (li trovi su https://supabase.com -> il tuo progetto -> Project Settings
#     -> Data API / API Keys)
#
# ATTENZIONE: la chiave "anon" e' pubblica per definizione: finisce dentro il
# sito e chiunque puo' leggerla. La sicurezza dei tuoi dati e' garantita dalle
# policy RLS create da supabase/schema.sql, non dal tenere segreta la chiave.
# NON inserire mai qui la chiave "service_role".
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=incolla-qui-la-tua-chiave-anon-pubblica
